# ---------------------------------------------------------------------------
# Tadika Cahaya Bintang Portal — environment configuration template
# Copy this file to `.env.local` and fill in real values, then restart the app:
#   cp .env.local.example .env.local
# Leave values empty/absent to keep running in DEMO MODE (no backend needed).
# ---------------------------------------------------------------------------

# --- Firebase (https://console.firebase.google.com) --------------------------
# Client SDK config: Firebase Console > Project settings > Your apps > Web app.
# These are safe to expose (they are not secrets) hence the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NOT USED: this portal runs on Auth + Firestore only and never uploads files.
# Cloud Storage for Firebase needs the paid Blaze plan, so the app deliberately
# does not initialise Storage. Safe to leave blank; copy it from the console
# only if you later enable Storage on purpose.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- AI assistant (optional, both providers have a genuinely free tier) -------
# IMPORTANT: these are SERVER-ONLY. Do NOT add the NEXT_PUBLIC_ prefix — the
# assistant calls /api/ai, which keeps the keys on the server. A key shipped to
# the browser can be harvested and used up on your quota by strangers.
#
# Google Gemini (recommended, generous free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional second/free provider — tried if Gemini fails: https://console.groq.com/keys
GROQ_API_KEY=
# Override the default free-tier models if Google/Groq rename or deprecate them.
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
# Max AI requests per minute per visitor (protects your free quota).
AI_RATE_LIMIT=12
